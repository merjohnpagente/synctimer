# Copy this file to `.env` and fill in your Firebase web app values.
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# The Realtime Database URL looks like:
#   https://YOUR-PROJECT-default-rtdb.firebaseio.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: public website address used for invite links generated INSIDE
# the installed app (where window.location.origin would be https://localhost).
VITE_PUBLIC_WEB_URL=https://johntimer.vercel.app
